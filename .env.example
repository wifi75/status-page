# Variabili dello stack Portainer (mai committare il .env reale)

# Versione dell'immagine da usare: latest oppure un tag, es. 0.2.0
IMAGE_TAG=latest
# Porta esposta sul server Docker, verso cui punta HAProxy
APP_PORT=8085

ADMIN_USERNAME=admin
# Hash bcrypt della password admin (vedi README, "Password admin").
# Vuoto = area admin disabilitata. In Portainer i $ vanno raddoppiati: $$2a$$10$$...
ADMIN_PASSWORD_HASH=

STATUS_SITE_TITLE=Stato dei servizi
# Etichetta accanto al titolo (es. un nominativo radio), vuota = nascosta
STATUS_BADGE=IU3CYV

# Solo fuori da Docker: percorso del file SQLite (default ./data/status.db)
# DB_PATH=./data/status.db
